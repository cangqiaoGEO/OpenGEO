{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"0 \u00b7 \u5148\u770b\u8fd9\u9875","text":"<p>\u4e00\u53e5\u8bdd\uff1aOpenGEO \u662f\u7ed9\u300cAI \u63a8\u8350\u8c01\u300d\u8fd9\u4ef6\u4e8b\u505a\u4e00\u628a\u516c\u5f00\u7684\u5c3a\u5b50\uff1b\u4ed3\u6865\u7528\u8fd9\u628a\u5c3a\u5b50\u505a\u751f\u610f\uff0c\u4f46\u5c3a\u5b50\u4e0d\u5f52\u4ed3\u6865\u3002</p> <p></p>"},{"location":"#30","title":"30 \u79d2\u7248\u672c","text":"<ol> <li>\u5ba2\u6237\u73b0\u5728\u5148\u95ee AI\u300c\u54ea\u5bb6\u597d\u300d\uff0cAI \u53ea\u63a8 3~4 \u5bb6\uff1b</li> <li>\u5e02\u573a\u4e0a\u5230\u5904\u662f\u300c\u4fdd\u6392\u540d\u300d\u7684\u5c71\u5be8\u670d\u52a1\u5546\u2014\u2014\u50cf 2010 \u5e74\u7684\u534e\u5f3a\u5317\uff1b</li> <li>\u5c71\u5be8\u673a\u662f\u88ab\u300c\u8dd1\u5206\u300d\u6740\u6b7b\u7684\uff1b\u6211\u4eec\u8981\u505a GEO \u7684\u8dd1\u5206\uff1aOpenGEO Index\uff1b</li> <li>\u5c3a\u5b50\u653e\u5728\u5f00\u6e90\u7ec4\u7ec7\u91cc\uff0c\u4ed3\u6865\u53ea\u505a\u57f9\u8bad\u3001\u4ea4\u4ed8\u3001\u6258\u7ba1\u2014\u2014\u88c1\u5224\u548c\u9009\u624b\u5206\u5f00\u3002</li> </ol>"},{"location":"#_1","title":"\u600e\u4e48\u7528\u8fd9\u5957\u6559\u7a0b","text":"<p>\u6bcf\u9875\u53ea\u6709\u4e00\u5f20\u5927\u56fe + \u4e09\u53e5\u8bdd + \u4e00\u9053\u9898\u300210 \u9875\uff0c30 \u5206\u949f\u3002\u770b\u5b8c\u80fd\u7528\u4e00\u53e5\u8bdd\u8bb2\u6e05\u6bcf\u4e00\u5c42\uff0c\u518d\u53bb\u8bfb\u5168\u5458\u5b66\u4e60\u624b\u518c\u548c\u8be6\u89e3\u7248\u8bfe\u7a0b\u3002</p> \u81ea\u6d4b\uff1aOpenGEO \u548c\u4ed3\u6865\u662f\u4e00\u56de\u4e8b\u5417\uff1f <p>\u4e0d\u662f\u3002OpenGEO \u662f\u5f00\u6e90\u7ec4\u7ec7\uff08\u88c1\u5224\uff09\uff0c\u4ed3\u6865\u662f\u516c\u53f8\uff08\u9009\u624b\uff09\u3002\u5bf9\u5916\u8bb2\u6807\u51c6\u8bf4 OpenGEO\uff0c\u8bb2\u670d\u52a1\u8bf4\u4ed3\u6865\u3002</p>"},{"location":"onepage/","title":"\u4e00\u56fe\u770b\u61c2 OpenGEO\uff08\u53ef\u4fdd\u5b58\uff09","text":"<p>\u4e0b\u9762\u662f\u4e00\u4e2a\u72ec\u7acb\u7684 HTML \u9875\u9762\uff0c\u70b9\u51fb\u6bcf\u4e00\u5c42\u53ef\u5c55\u5f00\uff1b\u53f3\u952e\u53e6\u5b58\u5373\u53ef\u79bb\u7ebf\u4f7f\u7528\u3002</p> <p>\u6253\u5f00\u4e00\u56fe\u770b\u61c2\u9875\u9762</p> <p></p>"},{"location":"p1-problem/","title":"1 \u00b7 \u95ee\u9898\uff5c\u5ba2\u6237\u53bb\u95ee AI \u4e86","text":"<ul> <li>\u5ba2\u6237\u6709\u9700\u6c42\uff0c\u5148\u95ee\u8c46\u5305\u3001\u5143\u5b9d\u3001DeepSeek\uff0c\u4e0d\u518d\u7ffb\u5341\u9875\u641c\u7d22\u7ed3\u679c\uff1b</li> <li>AI \u4e00\u6b21\u53ea\u63a8 3~4 \u5bb6\uff0c\u5176\u4f59\u8fde\u540d\u5b57\u90fd\u4e0d\u51fa\u73b0\uff1b</li> <li>\u6240\u4ee5\u65b0\u95ee\u9898\u4e0d\u662f\u300c\u6392\u7b2c\u51e0\u300d\uff0c\u800c\u662f\u300c\u6709\u6ca1\u6709\u4e0a\u724c\u684c\u300d\u3002</li> </ul> <p>\u4e00\u53e5\u8bdd</p> <p>\u8ba9 AI \u770b\u89c1\u4f60 \u2192 \u770b\u61c2\u4f60 \u2192 \u76f8\u4fe1\u4f60 \u2192 \u63a8\u8350\u4f60\uff0c\u8fd9\u5c31\u662f GEO\u3002</p> \u81ea\u6d4b\uff1aAI \u4e3a\u4ec0\u4e48\u6ca1\u63d0\u5230\u6211\u4eec\uff1f <p>AI \u53ea\u8bfb\u5b83\u80fd\u68c0\u7d22\u5230\u3001\u80fd\u6838\u5b9e\u7684\u8d44\u6599\u3002\u5b98\u7f51\u4e0d\u53ef\u6293\u53d6\u3001\u767e\u79d1\u6ca1\u6709\u3001\u53e3\u5f84\u6df7\u4e71\uff0c\u5b83\u5c31\u5f53\u4f60\u4e0d\u5b58\u5728\u2014\u2014\u5927\u516c\u53f8\u4e5f\u53ef\u80fd\u662f 18 \u5206\u3002</p>"},{"location":"p2-history/","title":"2 \u00b7 \u5386\u53f2\uff5c\u534e\u5f3a\u5317\u53c8\u6765\u4e86","text":"<ul> <li>2010 \u5e74\uff1a\u6512\u673a\u96f6\u95e8\u69db \u2192 \u53c2\u6570\u865a\u6807 \u2192 \u4fe1\u606f\u5dee\u5b9a\u4ef7 \u2192 \u6ca1\u552e\u540e\uff1b</li> <li>2026 \u5e74\uff1a\u6512\u8bfe\u96f6\u95e8\u69db \u2192 \u300c\u4fdd\u6392\u540d\u300d \u2192 \u9ed1\u7bb1\u62a5\u4ef7 \u2192 \u4e0d\u590d\u6d4b\uff1b</li> <li>\u5c71\u5be8\u673a\u4e0d\u662f\u88ab\u66f4\u4fbf\u5b9c\u6740\u6b7b\u7684\uff0c\u662f\u88ab\u5b89\u5154\u5154\u8dd1\u5206\u6740\u6b7b\u7684\u2014\u2014\u53ef\u6bd4\u8f83\u4e86\uff0c\u865a\u6807\u5c31\u6ca1\u5904\u85cf\u3002</li> </ul> <p>\u4e00\u53e5\u8bdd</p> <p>\u5c71\u5be8\u6b7b\u4e8e\u53ef\u6bd4\u8f83\uff0c\u5272\u97ed\u83dc\u6b7b\u4e8e\u53ef\u590d\u6d4b\u3002 \u6211\u4eec\u8981\u505a\u7684\u5c31\u662f\u90a3\u628a\u5c3a\u5b50\u3002</p> \u81ea\u6d4b\uff1a\u5b89\u5154\u5154\u6709\u4ec0\u4e48\u6559\u8bad\uff1f <p>\u4e24\u6761\uff1a\u2460 \u5b83\u88ab\u5f53\u6210\u300c\u5c0f\u7c73\u7cfb\u300d\uff0c\u88c1\u5224\u88ab\u8d28\u7591\u504f\u5411\uff1b\u2461 \u5382\u5546\u5bf9\u8dd1\u5206\u4f5c\u5f0a\u3002\u6240\u4ee5\u6211\u4eec\u7684\u5c3a\u5b50\u8981\u653e\u5728\u5f00\u6e90\u7ec4\u7ec7\u91cc\u3001\u8981\u9632\u6295\u6bd2\u3001\u9ed8\u8ba4\u4e0d\u8ff7\u4fe1\u603b\u5206\u3002</p>"},{"location":"p3-six-floors/","title":"3 \u00b7 \u5168\u8c8c\uff5c\u516d\u5c42\u697c","text":"\u5c42 \u4e00\u53e5\u8bdd \u4ed3\u5e93 L0 \u89c4\u8303 \u54c1\u724c\u4e8b\u5b9e\u5e93\uff0c\u552f\u4e00\u4e8b\u5b9e\u6e90 opengeo-spec L1 \u6d4b\u91cf \u516d\u7ef4\u4f53\u68c0 + \u5468\u6d4b opengeo-audit L2 \u6d1e\u5bdf \u5ba2\u6237\u4f1a\u600e\u4e48\u95ee\u3001\u5185\u5bb9\u7f3a\u4ec0\u4e48 opengeo-insights L3 \u6267\u884c \u603b\u63a7 + \u4e03\u4e2a AI \u5458\u5de5 opengeo-skills L4 \u7ad9\u70b9 \u5b98\u7f51\u8ba9 AI \u8bfb\u5f97\u61c2 opengeo-agentready L5 \u57fa\u51c6 OpenGEO Index \u884c\u4e1a\u6392\u884c\u699c opengeo-index <p>\u4e00\u53e5\u8bdd</p> <p>\u5148\u76d6 L0 / L1 / L3 \u4e09\u5c42\uff08\u7b2c\u4e00\u6279\uff09\uff0c\u5176\u4f59\u4e09\u5c42\u662f\u7b2c\u4e8c\u6279\u3002\u6240\u6709\u697c\u5c42\u90fd\u8e29\u5728 L0 \u4e0a\u3002</p> \u81ea\u6d4b\uff1a\u4e3a\u4ec0\u4e48 L0 \u5728\u6700\u5e95\u4e0b\uff1f <p>\u6bcf\u4e00\u5c42\u90fd\u53ea\u51c6\u5f15\u7528\u4e8b\u5b9e\u5e93\u91cc\u300c\u8001\u677f\u786e\u8ba4\u8fc7\u300d\u7684\u4e8b\u5b9e\u3002\u4e8b\u5b9e\u4e0d\u7a33\uff0c\u4e0a\u9762\u5168\u662f\u7a7a\u4e2d\u697c\u9601\u3002</p>"},{"location":"p4-facts/","title":"4 \u00b7 L0\uff5c\u4e8b\u5b9e\u5e93\u7684\u8eab\u4efd\u8bc1","text":"<ul> <li>\u6bcf\u6761\u5356\u70b9\u4e00\u4e2a\u6587\u4ef6\uff0c\u9876\u4e0a\u6709\u5f20\u300c\u8eab\u4efd\u8bc1\u300d\uff1a\u8c01\u5199\u7684\u3001\u8c01\u6838\u7684\u3001\u8fc7\u6ca1\u8fc7\u671f\u3001\u6765\u6e90\u662f\u4ec0\u4e48\uff1b</li> <li>\u4e09\u4e2a\u706f\uff1adraft \u7ea2\u706f\uff08\u6ca1\u5ba1\uff0c\u4e0d\u51c6\u5f15\u7528\uff09\u2192 \u5f85\u786e\u8ba4 \u9ec4\u706f \u2192 stable \u7eff\u706f\uff08\u8001\u677f\u786e\u8ba4\uff0c\u53ef\u5f15\u7528\uff09\uff1b</li> <li><code>okf_lint</code> \u4e00\u952e\u68c0\u67e5\uff1a\u6ca1\u8eab\u4efd\u8bc1\u3001\u7ea2\u706f\u5192\u5145\u7eff\u706f\u3001\u8fc7\u671f\u3001\u65ad\u94fe\u3001\u4e24\u5904\u53e3\u5f84\u6253\u67b6\uff0c\u5168\u90e8\u62a5\u51fa\u6765\u3002</li> </ul> <p>\u4e00\u53e5\u8bdd</p> <p>\u8001\u677f\u53ea\u505a\u4e24\u4ef6\u4e8b\uff1a\u5b9a\u6807\u7b7e\u3001\u6309\u7eff\u706f\u3002 \u5176\u4f59\u4ea4\u7ed9 AI \u548c lint\u3002</p> \u81ea\u6d4b\uff1a\u4e00\u6761 stable \u7684\u4e8b\u5b9e\uff0cAI \u4e00\u5b9a\u80fd\u5f15\u7528\u5417\uff1f <p>\u8fd8\u8981\u770b <code>verified.by</code>\uff1a<code>human:</code> \u662f\u4eba\u786e\u8ba4\uff08\u53ef\u5f15\u7528\uff09\uff1b<code>tool:</code> / <code>machine:</code> \u662f\u673a\u5668\u786e\u8ba4\uff0c\u53ea\u80fd\u5f53\u6570\u636e\uff08\u5206\u6570\u3001\u65e5\u671f\uff09\u5f15\u7528\u3002</p>"},{"location":"p5-audit/","title":"5 \u00b7 L1\uff5c\u4f53\u68c0\u62a5\u544a","text":"<ul> <li>\u56fa\u5b9a 20 \u95ee\uff0c\u5728\u6bcf\u4e2a AI \u5f15\u64ce\u9010\u6761\u95ee\uff0c\u8bb0\u5f55\uff1a\u63d0\u5230\u6ca1\u3001\u63a8\u8350\u6ca1\u3001\u5f15\u7528\u4e86\u8c01\u3001\u8bf4\u5f97\u5bf9\u4e0d\u5bf9\uff1b</li> <li>\u516d\u4e2a\u7ef4\u5ea6\u6309\u6743\u91cd\u5408\u6210\uff1a\u53ef\u89c1\u5ea6 30 / \u63a8\u8350\u5ea6 20 / \u5f15\u7528\u6e90 15 / \u8986\u76d6\u5ea6 15 / \u60c5\u611f 10 / \u5185\u5bb9\u57fa\u7840 10\uff1b</li> <li>\u9ed8\u8ba4 diagnostic \u6a21\u5f0f\u4e0d\u53d1\u603b\u5206\uff0c\u53ea\u544a\u8bc9\u4f60\u54ea\u4e00\u7ef4\u6700\u5f31\u3001\u5148\u8865\u4ec0\u4e48\uff1b\u8981\u53d1\u603b\u5206\uff0c\u5fc5\u987b\u540c\u65f6\u9644\u6539\u8fdb\u6e05\u5355\u3002</li> </ul> <p>\u4e00\u53e5\u8bdd</p> <p>\u4e00\u6761\u547d\u4ee4\uff1a\u91c7\u96c6\u597d\u7684\u8bc1\u636e \u2192 \u8bc4\u5206 \u2192 \u5ba1\u8ba1 \u2192 HTML \u62a5\u544a \u2192 \u5199\u56de\u4e8b\u5b9e\u5e93\u3002 \u5206\u6570\u4e0d\u662f\u76ee\u7684\uff0c\u590d\u6d4b\u5bf9\u6bd4\u624d\u662f\u3002</p> \u81ea\u6d4b\uff1a\u91c7\u96c6\u4e3a\u4ec0\u4e48\u4e0d\u80fd\u653e\u5230 GitHub \u81ea\u52a8\u8dd1\uff1f <p>\u4e2d\u56fd\u5f15\u64ce\u6ca1\u6709\u5f00\u653e\u63a5\u53e3\uff0c\u53ea\u80fd\u7528\u81ea\u5df1\u7684\u8d26\u53f7\u3001\u53ef\u89c1\u6d4f\u89c8\u5668\u3001\u4f4e\u9891\u6162\u6162\u95ee\uff1b\u5931\u8d25\u5c31\u505c\uff0c\u4eba\u6765\u63a5\u624b\uff0c\u7edd\u4e0d\u4f2a\u9020\u6570\u636e\u3002</p>"},{"location":"p6-skills/","title":"6 \u00b7 L3\uff5c\u603b\u7ba1\u548c\u4e03\u4e2a\u5458\u5de5","text":"<ul> <li>\u603b\u63a7 Agent \u8bfb\u4e8b\u5b9e\u5e93\u3001\u6d3e\u4efb\u52a1\u3001\u51fa\u5468\u62a5\uff1b</li> <li>\u4e03\u4e2a AI \u5458\u5de5\uff1aS1 \u8bca\u65ad \u00b7 S2 \u610f\u56fe\u8bcd \u00b7 S3 \u5185\u5bb9 \u00b7 S4 \u77ed\u89c6\u9891 \u00b7 S5 \u53d1\u5e03 \u00b7 S6 \u5b98\u7f51\u5730\u57fa \u00b7 S7 \u590d\u6d4b\uff1b</li> <li>\u95e8\u7981\u4e09\u6761\uff1a\u53ea\u51c6\u5f15\u7528\u7eff\u706f\u4e8b\u5b9e\uff1b\u5f15\u7528\u5fc5\u9644\u6765\u6e90\uff1b\u5e72\u6d3b\u524d\u5148\u8dd1 lint\u3002</li> </ul> <p>\u4e00\u53e5\u8bdd</p> <p>\u522b\u4eba\u7684 Agent \u6b62\u4e8e\u300c\u751f\u6210\u65b9\u6848\u300d\uff0c\u6211\u4eec\u7684\u95ed\u73af\u5230\u300c\u590d\u6d4b\u5206\u6570\u300d\u3002 \u5e73\u53f0\u4e0d\u9650\uff1aWorkBuddy \u662f v1 \u53c2\u8003\u5b9e\u73b0\uff0cClaude Code \u4e00\u6761\u547d\u4ee4\u5b89\u88c5\u3002</p> \u81ea\u6d4b\uff1aS3 \u5199\u4e86\u4e00\u7bc7\u6587\u7ae0\uff0c\u91cc\u9762\u63d0\u5230\u300c\u5ba2\u6237 300 \u5bb6\u300d\uff0c\u4f46\u4e8b\u5b9e\u5e93\u91cc\u662f draft\uff0c\u600e\u4e48\u529e\uff1f <p>\u4e0d\u80fd\u8fdb\u6b63\u6587\u3002\u53ea\u80fd\u653e\u8fdb\u300c\u5f85\u786e\u8ba4\u300d\u6bb5\uff0c\u63a8\u9001\u98de\u4e66\u5f85\u5ba1\uff0c\u8001\u677f\u70b9\u300c\u901a\u8fc7\u300d\u540e\u624d\u53d8\u7eff\u706f\u3002</p>"},{"location":"p7-loop/","title":"7 \u00b7 \u95ed\u73af\uff5c\u8f6c\u4e00\u5708\uff0c\u5206\u6570\u8bf4\u8bdd","text":"<ul> <li>\u5b9a\u53e3\u5f84\uff08L0\uff09\u2192 \u51fa\u9898\uff08L2\uff09\u2192 \u751f\u4ea7\uff08L3\uff09\u2192 \u4e0a\u7ad9\uff08L4\uff09\u2192 \u590d\u6d4b\uff08L1\uff09\u2192 \u7ed3\u679c\u5199\u56de\u4e8b\u5b9e\u5e93\uff08L0\uff09\uff1b</li> <li>\u4ed3\u6865\u81ea\u5df1\u5c31\u662f\u7b2c\u4e00\u4e2a\u5ba2\u6237\uff1a\u57fa\u7ebf 18 \u5206\uff0cD \u7ea7\uff0c\u5df2\u516c\u5f00\uff1b</li> <li>\u6bcf\u5468\u4e00\u6b21\u590d\u6d4b\uff0c\u6da8\u8dcc\u90fd\u53d1\u2014\u2014\u8dcc\u4e86\u4e5f\u516c\u5f00\uff0c\u8fd9\u624d\u662f\u53ef\u4fe1\u7684\u6765\u6e90\u3002</li> </ul> <p>\u4e00\u53e5\u8bdd</p> <p>\u8f6c\u591f\u51e0\u5708\uff0c\u6240\u6709\u54c1\u724c\u7684\u5206\u6570\u6c47\u5230 L5 OpenGEO Index\uff0c\u884c\u4e1a\u5c31\u6709\u4e86\u516c\u5f00\u7684\u5c3a\u5b50\u3002</p> \u81ea\u6d4b\uff1a\u590d\u6d4b\u7ed3\u679c\u5199\u56de\u4e8b\u5b9e\u5e93\u65f6\uff0cverified \u5199\u8c01\uff1f <p><code>tool:brand-geo-audit</code>\u2014\u2014\u673a\u5668\u786e\u8ba4\u7ea7\u3002\u5b83\u662f\u6570\u636e\uff0c\u4e0d\u662f\u4eba\u786e\u8ba4\u7684\u4e8b\u5b9e\u3002</p>"},{"location":"p8-rules/","title":"8 \u00b7 \u89c4\u77e9\uff5c\u88c1\u5224\u548c\u9009\u624b","text":"<ul> <li>\u8bf4\u8bdd\u7684\u89c4\u77e9\uff1a\u4e09\u4e0d\u627f\u8bfa\u3001\u4e09\u53ea\u627f\u8bfa\u3001\u516d\u6761\u767d\u5e3d\u7ea2\u7ebf\u2014\u2014\u8fdd\u53cd\u7684 issue / PR \u76f4\u63a5\u5173\uff1b</li> <li>\u8eab\u4efd\u7684\u89c4\u77e9\uff1a\u5c3a\u5b50\u5f52 OpenGEO \u5f00\u6e90\u7ec4\u7ec7\uff0c\u751f\u610f\u5f52\u4ed3\u6865\uff1bOpenGEO Cloud \u662f\u4ed3\u6865\u7684\u5546\u4e1a\u4ea7\u54c1\uff0c\u4e0d\u8fdb\u5f00\u6e90\u7ec4\u7ec7\uff1b</li> <li>\u6539\u5c3a\u5b50\u8981\u8d70 RFC\uff1a\u89c4\u8303\u5b57\u6bb5\u3001\u8bc4\u5206\u6743\u91cd\u3001\u65b0\u5f15\u64ce\u3001\u57fa\u51c6 schema\uff0c\u56db\u7c7b\u53d8\u66f4\u5148\u63d0\u6848\u3001\u4e24\u4f4d\u7ef4\u62a4\u8005\u6279\u51c6\u3002</li> </ul> <p>\u4e00\u53e5\u8bdd</p> <p>\u884c\u4e1a\u57fa\u51c6\u5bf9\u5916\u53ea\u53eb OpenGEO Index / OpenGEO \u53ef\u89c1\u5ea6\u6307\u6570\u3002\u5185\u90e8\u4ee3\u53f7\u4e0d\u4e0a\u5916\u5ba3\u3002</p> \u81ea\u6d4b\uff1a\u5ba2\u6237\u95ee\u300c\u80fd\u4fdd\u8bc1\u6211\u4eec\u6392\u7b2c\u4e00\u5417\u300d\uff0c\u600e\u4e48\u7b54\uff1f <p>\u4e0d\u80fd\uff0c\u4efb\u4f55\u4eba\u90fd\u4e0d\u80fd\u3002\u6211\u4eec\u627f\u8bfa\u4e09\u4ef6\u4e8b\uff1a\u8bca\u65ad\u5206\u6570\u3001\u6539\u8fdb\u6e05\u5355\u3001\u590d\u6d4b\u5bf9\u6bd4\u3002\u7136\u540e\u628a\u907f\u5751\u6307\u5357\u53d1\u7ed9\u4ed6\u3002</p>"},{"location":"p9-you/","title":"9 \u00b7 \u4f60\uff5c\u7ad9\u5728\u54ea\u4e00\u5c42","text":"\u89d2\u8272 \u4eba \u672c\u6708\u4ea4\u4ed8 \u7edf\u7b79 1 \u5468\u4f8b\u4f1a\u3001\u8de8\u4ed3\u770b\u677f\u3001\u53cc\u5468 release note \u89c4\u8303 L0 1 lint \u8fed\u4ee3\u3001\u884c\u4e1a\u8bcd\u8868\u3001\u4ed3\u6865 bundle \u5168\u7eff\u706f \u6d4b\u91cf L1 3 \u4e09\u5f15\u64ce\u91c7\u96c6\u5668\u8dd1\u901a 20 \u95ee\u3001\u4ed3\u6865\u6bcf\u5468\u4e00\u590d\u6d4b \u6267\u884c L3 3 WorkBuddy \u4e03\u6280\u901a\u5173\u3001Claude Code \u8dd1\u901a S3 \u8bfe\u7a0b/\u8fd0\u8425 1 \u8bfe\u7a0b\u7ad9\u3001\u516c\u5f00\u8bfe\u3001\u793e\u7fa4\u3001release note \u5206\u53d1"},{"location":"p9-you/#_1","title":"\u4e00\u5468\u5b66\u4e60\u8def\u5f84","text":"<ol> <li>\u7b2c 1\u20132 \u5929\uff1a\u8bfb README + GOVERNANCE\uff1b\u672c\u5730\u8dd1\u4e00\u6b21 <code>okf_lint</code> \u548c <code>run_audit.py</code>\uff1b</li> <li>\u7b2c 3\u20135 \u5929\uff1a\u6309\u81ea\u5df1\u90a3\u4e00\u5c42\u52a8\u624b\uff08\u8be6\u89c1\u5168\u5458\u5b66\u4e60\u624b\u518c\u7b2c\u4e09\u90e8\u5206\uff09\uff1b</li> <li>\u7b2c 5 \u5929\uff1a\u5168\u5458\u684c\u9762\u63a8\u6f14\u300c\u4e00\u4e2a\u5ba2\u6237\u4ece 0 \u5230\u590d\u6d4b\u300d\uff1b</li> <li>\u9a8c\u6536\uff1a10 \u9898\u7b54\u5bf9 8 \u9898\u3002</li> </ol> <p>\u4e00\u53e5\u8bdd</p> <p>\u8ba4\u9886 issue \u5c31\u662f\u4e0a\u5c97\uff1aopengeo-spec \u00b7 opengeo-audit \u00b7 opengeo-skills</p>"}]}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cangqiaoedu.local/schemas/query-protocol.schema.json",
  "title": "Brand GEO Query Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "scope_id",
    "context_id",
    "status",
    "created_at",
    "queries"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "protocol_id": {"type": "string", "pattern": "^protocol-[a-z0-9][a-z0-9-]*$"},
    "scope_id": {"type": "string", "pattern": "^scope-[a-z0-9][a-z0-9-]*$"},
    "context_id": {"type": "string", "pattern": "^context-[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["draft", "frozen"]},
    "created_at": {"type": "string", "format": "date-time"},
    "queries": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "query_type",
          "query",
          "audience_ids",
          "problem_ids",
          "high_value_question_ids",
          "business_rationale",
          "commercial_relevance",
          "expected_evidence",
          "engines"
        ],
        "properties": {
          "query_id": {"type": "string", "pattern": "^q-[a-z0-9][a-z0-9-]*$"},
          "query_type": {"enum": ["brand_direct", "category_recommendation", "solution", "brand_comparison", "customer_problem", "alternative", "risk", "fact_check"]},
          "query": {"type": "string", "minLength": 1},
          "audience_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "problem_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "high_value_question_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "business_rationale": {"type": "string", "minLength": 1},
          "commercial_relevance": {"enum": ["high", "medium", "low"]},
          "expected_evidence": {
            "type": "array",
            "items": {"enum": ["position", "recommendation", "citations", "coverage", "sentiment", "fact_accuracy"]},
            "minItems": 1,
            "uniqueItems": true
          },
          "engines": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 3,
            "uniqueItems": true
          },
          "competitor_ids": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    }
  }
}

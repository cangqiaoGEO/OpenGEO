{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cangqiaoedu.local/schemas/measurement-plan.schema.json",
  "title": "Brand GEO Measurement Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "measurement_plan_id", "run_id", "status", "query_protocol_id", "content_protocol_id", "critical_query_ids", "query_mappings", "aggregation_policy"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "measurement_plan_id": {"type": "string", "pattern": "^measurement-plan-[a-z0-9][a-z0-9-]*$"},
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["draft", "frozen"]},
    "query_protocol_id": {"type": "string"},
    "content_protocol_id": {"type": "string"},
    "critical_query_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "query_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_id", "decision_factor_ids", "location_ids", "commercial_relevance"],
        "properties": {
          "query_id": {"type": "string"},
          "decision_factor_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "location_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "commercial_relevance": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "aggregation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preserve_query_level_results", "preserve_channel_separation", "allow_cross_segment_offset"],
      "properties": {
        "preserve_query_level_results": {"const": true},
        "preserve_channel_separation": {"const": true},
        "allow_cross_segment_offset": {"const": false}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cangqiaoedu.local/schemas/quality-audit.schema.json",
  "title": "Brand GEO Quality Audit v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "audit_id", "protocol_id", "audit_date", "status", "confidence", "checks", "gaps", "counterevidence", "warnings", "next_validation_actions"],
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findings"],
      "properties": {
        "status": {"enum": ["pass", "warning", "fail"]},
        "findings": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "audit_id": {"type": "string", "pattern": "^audit-[a-z0-9][a-z0-9-]*$"},
    "protocol_id": {"type": "string"},
    "audit_date": {"type": "string", "format": "date"},
    "status": {"enum": ["passed", "passed_with_warnings", "insufficient_data", "failed"]},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_completeness", "sample_sufficiency", "source_reliability", "coverage_completeness", "cross_validation", "counterexample_review", "data_freshness", "traceability"],
      "properties": {
        "boundary_completeness": {"$ref": "#/$defs/check"},
        "sample_sufficiency": {"$ref": "#/$defs/check"},
        "source_reliability": {"$ref": "#/$defs/check"},
        "coverage_completeness": {"$ref": "#/$defs/check"},
        "cross_validation": {"$ref": "#/$defs/check"},
        "counterexample_review": {"$ref": "#/$defs/check"},
        "data_freshness": {"$ref": "#/$defs/check"},
        "traceability": {"$ref": "#/$defs/check"}
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "category", "description", "impact", "source_ids", "observation_ids", "next_action"],
        "properties": {
          "gap_id": {"type": "string", "pattern": "^gap-[a-z0-9][a-z0-9-]*$"},
          "category": {"enum": ["boundary", "sample", "source", "coverage", "cross_validation", "freshness", "traceability", "business_unknown"]},
          "description": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "observation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "next_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["counterevidence_id", "description", "source_ids", "observation_ids", "implication"],
        "properties": {
          "counterevidence_id": {"type": "string", "pattern": "^counter-[a-z0-9][a-z0-9-]*$"},
          "description": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "observation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "implication": {"type": "string", "minLength": 1}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "next_validation_actions": {"type": "array", "items": {"type": "string"}}
  }
}

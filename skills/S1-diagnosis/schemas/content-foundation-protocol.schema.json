{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cangqiaoedu.local/schemas/content-foundation-protocol.schema.json",
  "title": "Brand GEO Content Foundation Protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_protocol_id", "run_id", "brand_profile_id", "industry_profile_id", "status", "created_at", "probes"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "content_protocol_id": {"type": "string", "pattern": "^content-protocol-[a-z0-9][a-z0-9-]*$"},
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]*$"},
    "brand_profile_id": {"type": "string"},
    "industry_profile_id": {"type": "string"},
    "status": {"enum": ["draft", "frozen"]},
    "created_at": {"type": "string", "format": "date-time"},
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["probe_id", "probe_type", "applicability", "target_terms", "decision_factor_ids", "expected_evidence", "rationale"],
        "properties": {
          "probe_id": {"type": "string", "pattern": "^probe-[a-z0-9][a-z0-9-]*$"},
          "probe_type": {"enum": ["official_site", "structured_data", "local_listing", "review_profile", "social_account", "third_party_content", "knowledge_base", "authorized_relationship", "business_identity", "recent_activity"]},
          "applicability": {"enum": ["required", "conditional", "not_applicable"]},
          "target_terms": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
          "decision_factor_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "expected_evidence": {"type": "array", "items": {"enum": ["existence", "identity_match", "location_accuracy", "service_accuracy", "authority", "freshness", "review_signal", "structured_fields"]}, "minItems": 1, "uniqueItems": true},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

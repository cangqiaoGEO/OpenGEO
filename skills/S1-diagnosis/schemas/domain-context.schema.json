{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cangqiaoedu.local/schemas/domain-context.schema.json",
  "title": "Brand GEO Domain Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "scope_id",
    "status",
    "sources",
    "brand_positioning",
    "target_customers",
    "customer_problems",
    "products",
    "business_scenarios",
    "competitors",
    "high_value_questions",
    "unknowns"
  ],
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "items": {"type": "string", "pattern": "^src-[a-z0-9][a-z0-9-]*$"},
      "uniqueItems": true
    },
    "claimMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "evidence_ids"],
      "properties": {
        "status": {"enum": ["fact", "inference", "opinion", "unknown"]},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "claim"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]+-[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "claim": {"$ref": "#/$defs/claimMeta"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "context_id": {"type": "string", "pattern": "^context-[a-z0-9][a-z0-9-]*$"},
    "scope_id": {"type": "string", "pattern": "^scope-[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["draft", "ready"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "title", "url", "verification_status", "retrieved_at"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^src-[a-z0-9][a-z0-9-]*$"},
          "source_type": {"enum": ["official", "institutional", "authoritative_media", "industry_report", "third_party", "community", "user_provided", "audit_artifact"]},
          "title": {"type": "string", "minLength": 1},
          "url": {
            "oneOf": [
              {"type": "string", "pattern": "^https?://"},
              {"type": "null"}
            ]
          },
          "artifact_path": {"type": "string", "minLength": 1},
          "verification_status": {"enum": ["verified", "partially_verified", "unverified"]},
          "retrieved_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "brand_positioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "claim"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "claim": {"$ref": "#/$defs/claimMeta"}
      }
    },
    "target_customers": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "customer_problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "customer_ids", "claim"],
        "properties": {
          "id": {"type": "string", "pattern": "^problem-[a-z0-9][a-z0-9-]*$"},
          "description": {"type": "string", "minLength": 1},
          "customer_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "claim": {"$ref": "#/$defs/claimMeta"}
        }
      }
    },
    "products": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "business_scenarios": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "competitors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "relationship", "claim"],
        "properties": {
          "id": {"type": "string", "pattern": "^competitor-[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "relationship": {"enum": ["direct", "alternative", "adjacent"]},
          "claim": {"$ref": "#/$defs/claimMeta"}
        }
      }
    },
    "high_value_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "customer_ids", "problem_ids", "scenario_ids", "commercial_relevance", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^hvq-[a-z0-9][a-z0-9-]*$"},
          "question": {"type": "string", "minLength": 1},
          "customer_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "problem_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
          "scenario_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "commercial_relevance": {"enum": ["high", "medium", "low"]},
          "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "impact"],
        "properties": {
          "id": {"type": "string", "pattern": "^unknown-[a-z0-9][a-z0-9-]*$"},
          "question": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

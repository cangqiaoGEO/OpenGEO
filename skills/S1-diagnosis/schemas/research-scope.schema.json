{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cangqiaoedu.local/schemas/research-scope.schema.json",
  "title": "Brand GEO Research Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_id",
    "status",
    "brand",
    "domain",
    "market",
    "language",
    "audiences",
    "competitors",
    "depth",
    "as_of",
    "exclusions"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "scope_id": {"type": "string", "pattern": "^scope-[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["draft", "ready"]},
    "brand": {"type": "string", "minLength": 1},
    "domain": {"type": ["string", "null"], "minLength": 1},
    "market": {"type": ["string", "null"], "minLength": 1},
    "language": {"type": ["string", "null"], "minLength": 2},
    "audiences": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "competitors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "depth": {"enum": ["quick", "standard", "deep"]},
    "as_of": {"type": "string", "format": "date"},
    "exclusions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
